{
  "name": "dues-server",
  "version": "1.0.0",
  "description": "Dues Management System API Server",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:setup": "node src/db/setup.js",
    "db:seed": "node src/db/seed.js",
    "db:migrate": "node src/db/migrate.js",
    "db:renumber": "node src/db/renumber-receipts.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint src/ test/",
    "fmt": "prettier --write \"src/**/*.js\" \"test/**/*.js\"",
    "fmt:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.6",
    "pg": "^8.13.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.9.6"
  }
}
