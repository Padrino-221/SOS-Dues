# Server configuration
PORT=5000

# PostgreSQL connection.
# For a hosted database (Neon/Vercel) set DATABASE_URL and leave the PG* vars
# unset. For local development use the PG* vars below.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PGHOST=localhost
PGPORT=5432
PGDATABASE=dues_management
PGUSER=postgres
PGPASSWORD=CHANGE_ME

# JWT secret - MUST be a long random string, unique per environment
JWT_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# Client URL for CORS (comma-separated list supported). Not required when the
# frontend and API are served from the same Vercel deployment (same origin).
CLIENT_URL=http://localhost:5173

# Optional: email (SMTP) configuration
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=CHANGE_ME
# SMTP_FROM=Dues Management <no-reply@example.com>
# SMTP_SECURE=false

# Optional: default recipient override for receipt emails (otherwise the
# student's email is used when available)
# RECEIPT_EMAIL_TO=

# Optional: database pool limits (keep small on serverless, e.g. 5)
# PGPOOL_MAX=5
