# ═══════════════════════════════════════════════════════════════════
# Dues Management — server/.env for Vultr VPS (PostgreSQL on the same box)
# Copy to /opt/dues/server/.env and fill in the secrets.
# Generate JWT_SECRET with: openssl rand -hex 32
# ═══════════════════════════════════════════════════════════════════

# One PostgreSQL database for this app (created by deployment/vultr/setup-vps.sh).
# Preferred form — pool.js and db/setup.js both honour a connection string.
DATABASE_URL=postgresql://dues:CHANGE_DB_PASSWORD@localhost:5432/dues

# Alternative — the discrete variables used by local dev (unset DATABASE_URL to use these):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=dues
# PGUSER=dues
# PGPASSWORD=CHANGE_DB_PASSWORD

# PostgreSQL pool size (default 20 when unset). Every receipt transaction holds
# a connection for its whole duration, so this must cover concurrent cashiers;
# lower it only if the box is tight on connections/file descriptors.
# PGPOOL_MAX=20

# Access-token lifetime, in any format jsonwebtoken accepts (seconds or a
# span like 24h / 7d). Defaults to 24h when unset.
# NOTE: this replaces the old JWT_EXPIRES_IN variable — that name is no longer
# read, so remove it from any .env that still sets it.
JWT_TTL=24h

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

PORT=3001
NODE_ENV=production

# Exact origin of the SPA — CORS allow-list and links inside emails.
# No trailing slash; CORS matches the browser Origin header character-for-character.
CLIENT_URL=https://dues.sosuenr.com

# ── Super admin bootstrap ─────────────────────────────────────────────────────
# The super admin is created automatically by db:migrate (and db:seed) ONLY when
# the database has no super_admin account yet.
#
# LEAVE SUPER_ADMIN_PASSWORD UNSET IN PRODUCTION. A strong random password is
# then generated and printed ONCE to the deploy log — capture it from there and
# store it in a password manager. Setting it here is supported, but then it
# must be a unique, high-entropy secret: db:migrate runs on EVERY deploy, and a
# known default would publish a super admin with force-delete and
# account-management powers on the live site.
# SUPER_ADMIN_EMAIL=superadmin@sosuenr.com
# SUPER_ADMIN_NAME=Super Admin
# SUPER_ADMIN_PASSWORD=

# ── Email — Amazon SES in production (the plan's cost line assumes SES) ──────
# DELIVERY WARNING: with NODE_ENV=production and SMTP_HOST missing (or still
# containing CHANGE_ME), receipt emails are NOT delivered — email.js falls back
# to "dev mode" and only prints each "sent" receipt to the PM2 log. The API
# still reports success, so nobody finds out that the mail never went out.
# The server prints a loud startup warning until these are filled in; restart
# after editing.
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM="School of Sciences Dues <no-reply@sosuenr.com>"
